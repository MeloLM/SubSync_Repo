// Schema del database SubSync.
// Regola 1 (ARCHITECTURE.md): gli importi monetari sono Decimal, mai Float.

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // runtime: transaction pooler (pgbouncer)
  directUrl = env("DIRECT_URL")   // migrazioni: session pooler (direct)
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

// Stato di un invito alla condivisione di un abbonamento (Split-Billing, Sprint 5).
enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ─── Sprint 7 — Fiscalità & Ottimizzazione ──────────────────────────────────

// Natura della spesa: separa il personale dall'aziendale.
enum ExpenseNature {
  PERSONAL
  BUSINESS
  MIXED
}

// Tipologia del documento fiscale associato alla spesa.
enum FiscalDocumentType {
  NONE
  RECEIPT // scontrino / ricevuta
  INVOICE // fattura
}

// Regime IVA: copre i casi non esprimibili con la sola aliquota.
enum VatRegime {
  STANDARD // aliquota ordinaria
  REDUCED // aliquota ridotta
  EXEMPT // esente (es. art. 10)
  REVERSE_CHARGE // inversione contabile
  NON_TAXABLE // non imponibile
}

// ─── Sprint 8 — Email Ingestion ─────────────────────────────────────────────

// Ciclo di vita di un messaggio ricevuto. Rivendicato PRIMA dell'elaborazione,
// così un crash a metà strada non lo fa elaborare due volte al ritentativo.
// Solo FAILED è rielaborabile: gli altri sono stati terminali.
enum InboundStatus {
  RECEIVED // rivendicato, non ancora elaborato
  PARSED // estrazione riuscita
  PROPOSED // ha prodotto una PaymentProposal
  DISCARDED // non è una ricevuta transazionale: fuori ambito
  FAILED // errore di elaborazione, ritentabile
}

// Da dove viene la chiave di deduplicazione. Message-ID e hash del contenuto
// hanno garanzie diverse: sapere quale si sta guardando serve quando qualcosa
// va storto.
enum DedupeSource {
  MESSAGE_ID // header RFC 5322, normalizzato
  CONTENT_HASH // ripiego: SHA-256 di from + subject + date + corpo
}

enum ProposalStatus {
  PENDING // in attesa dell'utente: NON è ancora denaro
  APPROVED
  REJECTED
  EXPIRED // mai risolta entro il periodo previsto
}

// Come si è materializzata l'approvazione. È la traduzione sullo schema della
// regola "l'evidenza vince sulla previsione": se il cron aveva già scritto il
// pagamento di quel ciclo, la ricevuta lo CORREGGE, non ne aggiunge un secondo.
enum ProposalResolution {
  CREATED // nessun PaymentLog per quel ciclo: ne è nato uno nuovo
  RECONCILED // esisteva già (tipicamente da cron): corretto con i dati reali
}

// Origine di un pagamento. È un'ETICHETTA, non un filtro: nessun calcolo deve
// selezionare per `source` per essere corretto, quindi dimenticarsene non
// produce numeri sbagliati. È la ragione per cui questa colonna è ammessa dove
// uno `status` su PaymentLog non lo sarebbe.
enum PaymentSource {
  CRON // previsione: la data di rinnovo è arrivata
  EMAIL // evidenza: esiste una ricevuta
  MANUAL
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  createdAt     DateTime             @default(now())
  subscriptions Subscription[]
  memberships   SubscriptionMember[] // Abbonamenti condivisi con questo utente
  categories    ExpenseCategory[] // Categorie di spesa personalizzate (Sprint 7)

  // ─── Email Ingestion (Sprint 8) ───────────────────────────────────────────
  // Parte locale dell'indirizzo di ricezione dedicato: <token>@in.subsync.app.
  // Valore casuale da 128 bit in base32, NON derivato da `id`.
  //
  // ⚠️ È una credenziale al portatore: chi lo conosce può depositare ricevute in
  // questo account. Da qui due conseguenze sullo schema. Sta in una colonna a sé
  // e non coincide con `id`, perché un identificatore non si può ruotare e un
  // indirizzo destinato a finire in una regola di inoltro prima o poi trapela;
  // ed è nullable, perché si genera su richiesta e non alla registrazione.
  inboundToken          String?   @unique
  inboundTokenRotatedAt DateTime?

  inboundEmails InboundEmail[]
  proposals     PaymentProposal[]
}

model Subscription {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  amount          Decimal              @db.Decimal(12, 2) // Regola 1: Decimal, mai Float
  currency        String               @default("EUR")
  billingCycle    BillingCycle
  nextRenewalDate DateTime // Regola 2: forzata a 00:00:00 UTC pre-salvataggio
  createdAt       DateTime             @default(now())
  canceledAt      DateTime? // Soft-delete: null = attivo. Regola 2: 00:00:00 UTC
  payments        PaymentLog[]
  members         SubscriptionMember[] // Split-Billing: partecipanti invitati
  proposals       PaymentProposal[] // Ricevute email associate, in attesa o risolte

  // ─── Fiscalità (Sprint 7) — campi additivi, default retro-compatibili ───
  // Gli abbonamenti esistenti diventano PERSONAL e non deducibili.
  expenseNature     ExpenseNature      @default(PERSONAL) // personale/aziendale/misto
  categoryId        String? // FK → ExpenseCategory (opzionale)
  category          ExpenseCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  amountIsGross     Boolean            @default(true) // `amount` è IVA inclusa (lordo)?
  vatRate           Decimal            @default(22) @db.Decimal(5, 2) // aliquota IVA %
  vatRegime         VatRegime?         @default(STANDARD)
  costDeductiblePct Decimal            @default(0) @db.Decimal(5, 2) // % deducibilità del COSTO
  vatDeductiblePct  Decimal            @default(0) @db.Decimal(5, 2) // % detraibilità dell'IVA
  documentType      FiscalDocumentType @default(NONE)
  supplierVatId     String? // Partita IVA fornitore (fatture B2B)

  @@index([userId])
  @@index([categoryId])
  @@index([userId, expenseNature])
}

// Categoria di spesa con default fiscali (Sprint 7). `userId` null = categoria di
// sistema (seed condiviso); valorizzato = categoria personalizzata dall'utente.
model ExpenseCategory {
  id                       String         @id @default(cuid())
  userId                   String?
  user                     User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                     String
  nature                   ExpenseNature  @default(BUSINESS)
  defaultCostDeductiblePct Decimal        @default(100) @db.Decimal(5, 2) // deducibilità costo suggerita
  defaultVatRate           Decimal        @default(22) @db.Decimal(5, 2) // aliquota IVA suggerita
  defaultVatDeductiblePct  Decimal        @default(100) @db.Decimal(5, 2) // detraibilità IVA suggerita
  createdAt                DateTime       @default(now())
  subscriptions            Subscription[]

  @@unique([userId, name])
  @@index([userId])
}

// Split-Billing (Sprint 5): un partecipante invitato a dividere il costo di un
// abbonamento. Il proprietario (Subscription.user) partecipa implicitamente con
// peso 1; i membri qui elencati ricevono un invito e, una volta accettato, sono
// legati al loro account (`userId`) e vedono l'abbonamento condiviso.
model SubscriptionMember {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  // Account dell'invitato: null finché l'invito non viene accettato.
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Email dell'invito: usata per il matching invito → account al login.
  email          String
  status         InviteStatus @default(PENDING)
  // Peso della quota (Regola 1: Decimal). Default 1 = parti uguali col proprietario.
  shareWeight    Decimal      @default(1) @db.Decimal(12, 4)
  // Settlement: la quota dovuta è stata saldata al proprietario?
  settled        Boolean      @default(false)
  settledAt      DateTime?
  createdAt      DateTime     @default(now())

  @@unique([subscriptionId, email])
  @@index([subscriptionId])
  @@index([userId])
  @@index([email])
}

// Un pagamento avvenuto. INVARIANTE: ogni riga è denaro che si è mosso.
//
// ⚠️ Non aggiungere qui uno stato "in attesa di conferma". Lo storico del flusso
// di cassa, il Burn Rate e la timeline leggono questa tabella senza filtrarla,
// perché non c'è niente da filtrare: righe non confermate obbligherebbero ogni
// lettore ad aggiungere una condizione, e dimenticarla non darebbe un errore ma
// un totale gonfiato. Le proposte vivono in `PaymentProposal`, tabella che
// nessun calcolo somma.
model PaymentLog {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(12, 2) // Regola 1
  paidAt         DateTime     @default(now())

  // Chi ha scritto questa riga. Etichetta diagnostica, mai un filtro (vedi
  // PaymentSource). Il default riflette lo stato attuale: finora il cron è
  // l'unica sorgente, quindi le righe esistenti sono tutte CRON.
  source PaymentSource @default(CRON)

  // Popolata quando una ricevuta ha confermato o corretto questo pagamento:
  // una riga con una proposta collegata è corroborata da un documento reale,
  // non solo prevista dal calendario dei rinnovi.
  proposal PaymentProposal?

  @@index([subscriptionId])
}

/// Messaggio ricevuto sull'indirizzo dedicato di un utente.
///
/// È il registro dell'idempotenza: ogni messaggio viene **rivendicato** qui
/// prima di essere elaborato, e il vincolo di unicità impedisce che due consegne
/// concorrenti dello stesso messaggio producano due elaborazioni.
model InboundEmail {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Message-ID normalizzato (parentesi angolari rimosse, spazi tagliati) oppure,
  // quando manca o è malformato, l'hash del contenuto.
  dedupeKey    String
  dedupeSource DedupeSource

  fromAddress String
  subject     String
  receivedAt  DateTime

  status   InboundStatus @default(RECEIVED)
  attempts Int           @default(0)
  error    String?

  /// Esiti SPF/DKIM/ARC riportati dal provider inbound. Segnale di FIDUCIA nel
  /// contenuto, mai di identità: l'inoltro automatico rompe SPF quasi sempre, e
  /// un controllo bloccante scarterebbe la maggioranza dei messaggi legittimi.
  authResults Json?

  /// Risultato strutturato dell'estrazione. **Non** il corpo del messaggio: del
  /// contenuto si conserva il minimo indispensabile, perché è posta di persone
  /// reali e il modo più sicuro di trattare un dato sensibile è non averlo.
  parsedData Json?

  proposal  PaymentProposal?
  createdAt DateTime         @default(now())

  // ⚠️ L'idempotenza vive QUI, non in un controllo applicativo: `SELECT` poi
  // `INSERT` sono due operazioni, e due consegne concorrenti le superano
  // entrambe. Si tenta l'inserimento per primo e si intercetta la violazione.
  //
  // Lo scope è per utente e non globale di proposito: la stessa ricevuta
  // familiare inoltrata da due conviventi con account distinti è due fatti
  // legittimi, non un duplicato.
  @@unique([userId, dedupeKey])
  @@index([userId, status])
}

/// Pagamento estratto da una ricevuta, **in attesa di approvazione**.
///
/// Nessuna riga di questa tabella è denaro finché l'utente non conferma: è la
/// barriera che impedisce a un errore di lettura dell'estrattore di entrare nello
/// storico di cassa, dove sarebbe una bugia permanente nel grafico.
model PaymentProposal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Una proposta per messaggio: è il messaggio a generarla.
  inboundEmailId String       @unique
  inboundEmail   InboundEmail @relation(fields: [inboundEmailId], references: [id], onDelete: Cascade)

  // Abbonamento riconosciuto, oppure null quando nessuno corrisponde: in quel
  // caso l'approvazione creerà anche l'abbonamento, partendo da `serviceName`.
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  /// Nome del servizio come estratto dalla ricevuta.
  serviceName String
  amount      Decimal  @db.Decimal(12, 2) // Regola 1
  currency    String   @default("EUR")
  paidAt      DateTime // Regola 2: 00:00:00 UTC

  /// Nuovo prezzo dell'abbonamento, se la ricevuta ne segnala uno diverso.
  /// Approvare applica anche questo: un aumento non deve passare inosservato,
  /// ma nemmeno essere applicato di nascosto.
  proposedPrice Decimal? @db.Decimal(12, 2)

  matchScore Decimal  @default(0) @db.Decimal(5, 2)
  /// Quali segnali hanno prodotto il punteggio. Una proposta che non sa
  /// spiegarsi non è verificabile dall'utente.
  matchSignals String[]

  status ProposalStatus @default(PENDING)

  // ─── Esito dell'approvazione ──────────────────────────────────────────────
  // "L'evidenza vince sulla previsione": se il cron aveva già scritto il
  // pagamento di quel ciclo, approvare non ne crea un secondo (che
  // raddoppierebbe il mese nel flusso di cassa) ma corregge quello esistente.
  // `resolution` registra quale dei due percorsi è stato seguito.
  resolution   ProposalResolution?
  paymentLogId String?             @unique
  paymentLog   PaymentLog?         @relation(fields: [paymentLogId], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId, status])
  @@index([subscriptionId])
}
